# FINX Environment Configuration Template
# Copy to .env or set in runtime environment

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database
POSTGRES_DB=finx_db
POSTGRES_USER=finx_user
POSTGRES_PASSWORD=finx_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finx_db
SPRING_DATASOURCE_USERNAME=finx_user
SPRING_DATASOURCE_PASSWORD=finx_password

# Redis Configuration
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Security & JWT Tokens
# Secret key must be a base64 or 256-bit+ secure random key in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
