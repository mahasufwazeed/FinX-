{
    "name": "finx-monorepo",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=20.18.0"
    },
    "scripts": {
        "build": "npm run build --workspace=frontend",
        "start": "npm run start --workspace=frontend",
        "lint": "npm run lint --workspace=frontend",
        "dev:frontend": "npm run dev --workspace=frontend",
        "dev:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
        "test:backend": "cd backend && .\\mvnw.cmd clean test",
        "test:e2e": "node test-e2e-workflow.mjs"
    },
    "workspaces": [
        "frontend"
    ],
    "dependencies": {
        "pg": "^8.23.0"
    }
}
